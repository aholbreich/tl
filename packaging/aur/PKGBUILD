# Maintainer: Alexander Holbreich <alexander@holbreich.org>
# AUR package for tl - Git-native task ledger for humans and AI coding agents.
# Binary (-bin) package: downloads prebuilt Go binaries from GitHub releases.

pkgname=tl-bin
pkgver=0.9.0
pkgrel=1
pkgdesc='Git-native task ledger that lets humans and AI coding agents coordinate work in one repo'
arch=('x86_64' 'aarch64')
url='https://github.com/aholbreich/tl'
license=('MIT')
provides=('tl')
conflicts=('tl')
optdepends=('bash-completion: bash shell completion')

# Linux-only binary tarballs. The tarball contains a single `tl` executable.
# The LICENSE file is fetched separately because it is not shipped in the tarball.
source_x86_64=(
  "tl-${pkgver}-x86_64.tar.gz::https://github.com/aholbreich/tl/releases/download/${pkgver}/tl-linux-amd64.tar.gz"
  "LICENSE::https://raw.githubusercontent.com/aholbreich/tl/${pkgver}/LICENSE"
)
sha256sums_x86_64=(
  '261ec5a4003fb892469b69966e0ce295c8af3a6f7d3b934c8f4f687d0484d5af'
  '4636c186f0d359cc0dd2d46155b6fb9df70d9b30489b9a6fb9e9d48c6a7f570a'
)

source_aarch64=(
  "tl-${pkgver}-aarch64.tar.gz::https://github.com/aholbreich/tl/releases/download/${pkgver}/tl-linux-arm64.tar.gz"
  "LICENSE::https://raw.githubusercontent.com/aholbreich/tl/${pkgver}/LICENSE"
)
sha256sums_aarch64=(
  'fe28c71b261d71c0ba6fa5b1564aeabfcc740a635fd169fc38f2b48657b1a94e'
  '4636c186f0d359cc0dd2d46155b6fb9df70d9b30489b9a6fb9e9d48c6a7f570a'
)

package() {
  install -Dm755 "$srcdir/tl" "$pkgdir/usr/bin/tl"

  install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  # Shell completions generated by the binary at build time.
  "$srcdir/tl" completion bash > "$srcdir/tl.bash"
  "$srcdir/tl" completion zsh  > "$srcdir/tl.zsh"
  "$srcdir/tl" completion fish > "$srcdir/tl.fish"
  install -Dm644 "$srcdir/tl.bash" "$pkgdir/usr/share/bash-completion/completions/tl"
  install -Dm644 "$srcdir/tl.zsh"  "$pkgdir/usr/share/zsh/site-functions/_tl"
  install -Dm644 "$srcdir/tl.fish" "$pkgdir/usr/share/fish/vendor_completions.d/tl.fish"
}
